{
  "name": "qms-backend",
  "version": "1.0.0",
  "description": "Backend API for QMS (Quality Management System) with dummy authentication",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=server.js --watch-path=controllers --watch-path=data --watch-path=middleware --watch-path=routes --watch-path=utils server.js",
    "dev:backend": "node --watch-path=server.js --watch-path=controllers --watch-path=data --watch-path=middleware --watch-path=routes --watch-path=utils server.js",
    "stop": "node ../scripts/kill-ports.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "keywords": ["qms", "backend", "express", "auth"],
  "author": "",
  "license": "ISC"
}
